# Nathan Tutors server configuration
# Copy to .env.local and fill in the values you need.
# The site runs without these values, but email, storage, sign in and reCAPTCHA
# degrade to safe demo behaviour until they are set.

# Site
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# NextAuth
AUTH_SECRET=replace-with-a-long-random-string
NEXTAUTH_SECRET=replace-with-a-long-random-string

# Google OAuth (optional, the Google button is hidden when unset)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Google reCAPTCHA v3 (server key is never exposed to the browser)
NEXT_PUBLIC_RECAPTCHA_SITE_KEY=
RECAPTCHA_SECRET_KEY=

# Transactional email (nodemailer)
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM="Nathan Tutors <hello@nathan-tutors.co.ke>"

# Vercel KV (bookings, applications, progress notes)
KV_REST_API_URL=
KV_REST_API_TOKEN=

# Vercel Blob (tutor CV uploads)
BLOB_READ_WRITE_TOKEN=
